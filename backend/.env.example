########################################
# Database
########################################
DATABASE_URL=postgresql://astro_user:change_me@localhost:5432/astro_db

########################################
# Auth
########################################
SECRET_KEY=change_me_to_a_long_random_string
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
ADMIN_EMAIL=you@example.com

########################################
# App
########################################
ENV=development
LOG_LEVEL=INFO

########################################
# LLM
########################################
OPENAI_API_KEY=sk-your-key
OPENAPI_MODEL=gpt-5-chat-latest

# Transient-failure retry policy (network errors, rate limits, provider 5xx).
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=0.5

# How many times a schema-invalid response is handed back to the model for
# repair before the call is abandoned.
LLM_MAX_REPAIR_ATTEMPTS=2

# Optional. Per-million-token prices for your chosen model. Left unset, token
# usage is still logged and cost is reported as unknown rather than guessed.
# LLM_PRICE_INPUT_PER_1M=
# LLM_PRICE_OUTPUT_PER_1M=

########################################
# Chat context budget
########################################
# Ceiling on replayed conversation history, so prompt size (and cost per turn)
# stays flat no matter how long a session runs.
CHAT_HISTORY_TOKEN_BUDGET=2000
CHAT_MAX_HISTORY_TURNS=20
